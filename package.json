{
  "name": "tennis-bookings-flutter",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:ElihuJ/TennisBookings-Flutter.git",
  "author": "Elihu Del Valle <elihu@elihu.com.au>",
  "license": "MIT",
  "scripts": {
    "run-web": "flutter run -d chrome",
    "run-web-release": "flutter run -d chrome --release",
    "clear-web": "rm -rf ../Firebase/public/*",
    "build-web-prod": "flutter build web --release --dart-define=Dart2jsOptimization=00 --dart-define=ENV=prod",
    "build-web-uat": "flutter build web --dart-define=Dart2jsOptimization=00 --dart-define=ENV=uat",
    "push-tags": "git push --tags",
    "deploy-web-prod": "npm run use-prod && firebase deploy --only hosting --non-interactive --force",
    "deploy-web-uat": "npm run use-uat && firebase deploy --only hosting --non-interactive --force",
    "use-uat": "firebase use tennisbookings-uat",
    "use-prod": "firebase use tennisbookings"
  }
}
